{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localscore",
  "main": ".open-next/worker.js",
  // Serves the production domains; deploying replaces their DNS records.
  "routes": [
    { "pattern": "www.localscore.ai", "custom_domain": true },
    { "pattern": "localscore.ai", "custom_domain": true }
  ],
  // Only the custom domains: zone-level settings don't cover *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference for ISR revalidation; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "localscore"
    }
  ],
  "r2_buckets": [
    {
      // Create once: npx wrangler r2 bucket create localscore-opennext-cache
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "localscore-opennext-cache"
    }
  ],
  // Run next to Turso, not the visitor: pages make several DB round trips.
  "placement": { "mode": "targeted", "region": "aws:us-east-1" },
  "observability": { "enabled": true }
}
